      },
      {
        "G": 0,
        "P": 1,
        "S": 1,
        "name": "PaMCP_NoGap"
      },
      {
        "G": 0,
        "P": 1,
        "S": 0,
        "name": "G0_P1_S0"
      },
      {
        "G": 0,
        "P": 0,
        "S": 1,
        "name": "G0_P0_S1"
      },
      {
        "G": 0,
        "P": 0,
        "S": 0,
        "name": "G0_P0_S0"
      }
    ],
    "attribution": "The three leave-one-out comparisons are conditional marginal contrasts and are not assumed additive. Estimate factor main effects/interactions from all eight cells. Report Shapley attribution over the six factor orderings if additive attribution is needed."
  },
  "external_baselines": [
    {
      "name": "MCP-Zero",
      "adaptation": "Model-written tool requests; full active hierarchical discovery."
    },
    {
      "name": "COLT",
      "adaptation": "Retrain on MCPToolBench++ development split; scenes derived from server membership."
    },
    {
      "name": "ToolScope",
      "adaptation": "Reimplement retriever and merger; preserve provider identity, provenance, effects and contracts."
    },
    {
      "name": "CMTF/ToolChoiceConfusion",
      "adaptation": "Provide precondition-effect contracts; report contract source and adaptation."
    },
    {
      "name": "AutoTool (AAAI 2026)",
      "adaptation": "Adapt to MCP trajectories; E21 only."
    }
  ],
  "datasets": {
    "LiveMCPTool": "registry source",
    "MCPToolBench++": "registry and retrieval tasks",
    "merged_registry": "merged MCP registry, 569 tools",
    "LiveMCPBench": "multi-tool task benchmark",
    "credential_free_reference_servers": "actual observed-effect probing",
    "human_annotated_subset": "independent semantic typing reference",
    "purpose_built_calibration_sets": "model-profile evaluation",
    "synthetic_registry_clones": "scalability",
    "MCP_Bench_subset": "additional end-to-end execution"
  },
  "metric_contracts": {
    "Exp@k": "Fraction of requests whose top-k contains at least one independently reference-labelled unsafe tool.",
    "Util@5": "Hit among relevant read-only target tools; freeze denominator and alternative-target handling per dataset.",
    "group_recall@k": "Goal-group coverage; report separately from complete acceptable toolchain recall.",
    "joint_feasibility": "Independent evaluator verifies required outputs, interface compatibility, effects, policy and information flow.",
    "task_success": "External pre-registered task oracle.",
    "wrong_tool_calls": "Count irrelevant, invalid-state and policy-violating calls separately.",
    "executed_out_of_policy_actions": "Count actual sandbox actions executed outside the independently set policy; distinguish exposure and attempted actions.",
    "bridge_ratio": "Use the paper's exact formal Definition 3 and calibrated reliability product.",
    "token_cost": "Frozen tokenizer; raw tool definitions and sanitized manifest tokens are separate metrics.",
    "certificate": "Independent S,C,P,E,L,V per-check rates and overall conjunction."
  },
  "statistics": {
    "confidence_intervals": "Percentile bootstrap with declared resampling unit.",
    "paired_tests": "Paired sign-flip tests for matched tasks.",
    "multiple_testing": "Holm for preregistered confirmatory family; BH only for designated exploratory secondary family.",
    "E22": {
      "resampling_unit": [
        "request",
        "target_tool"
      ],
      "split": [
        "stratified",
        "tool_disjoint"
      ]
    },
    "reporting": [
      "N and exact denominator",
      "excluded/abstained/unresolved cases",
      "point estimate and CI",
      "paired effect and adjusted p-value",
      "seed/run id",
      "artifact hashes"
    ]
  },
