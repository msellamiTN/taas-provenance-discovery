    "G": "model-conditioned capability gap",
    "P": "provenance-sound eligibility",
    "S": "set-level reasoning and certification"
  },
  "factorial_design": {
    "cells": [
      {
        "G": 1,
        "P": 1,
        "S": 1,
        "name": "Full_PaMCP"
      },
      {
        "G": 1,
        "P": 1,
        "S": 0,
