  "baseline_catalog": "pamcp_baselines_v1.json",
  "pa_mcp_variants": {
    "Full_PaMCP": {
      "G": 1,
      "P": 1,
      "S": 1,
      "definition": "Model-conditioned gap + provenance-sound eligibility + set-level reasoning/certification."
    },
    "PaMCP_NoGap": {
      "G": 0,
      "P": 1,
      "S": 1,
      "definition": "Remove model capability hyperedges; set Gamma(q)=G(q). All other mechanisms unchanged."
    },
    "PaMCP_Declared": {
      "G": 1,
      "P": 0,
      "S": 1,
      "definition": "Published annotations and lexical cues only; no observed/attested evidence and no provenance trust policy. Preserve retrieval and certification. Separate MCP-defaults control."
    },
    "PaMCP_NoCert": {
      "G": 1,
      "P": 1,
      "S": 0,
      "definition": "Per-subgoal retrieval and union; no backward closure, global set checks, compatibility/effect/flow checks or certificate. Score counterfactual validity with independent evaluator."
    }
  },
  "dataset_integration_notes": [
    "ToolRet is a heterogeneous retrieval-only track and must not be pooled with MCP-native retrieval scores without stratified reporting.",
    "MCP-Atlas public release is 500 tasks; TRAJECTORY is a successful diagnostic trace, not an exhaustive acceptable composition oracle.",
    "Toolathlon-Verified and MCP-Universe require pinned execution environments and native evaluators.",
    "MCPTox and InjecAgent evaluate distinct threat models; report them as separate attack tracks.",
    "R-Judge is a risk-awareness benchmark, not an operational-effect reference dataset.",
    "τ³-bench is a stateful policy-compliance benchmark; it does not measure MCP registry discovery.",
    "Every external dataset remains planned_not_run until the exact release, license, split, evaluator and adapter validation are recorded."
  ]
}
