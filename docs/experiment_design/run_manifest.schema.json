{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaMCP Experiment Run Manifest v1",
  "type": "object",
  "required": [
    "spec_version",
    "experiment_id",
    "run_id",
    "status",
    "configuration",
    "dataset_snapshot",
    "code",
    "environment",
    "parameters",
    "metrics",
    "artifacts"
  ],
  "properties": {
    "spec_version": {
      "const": "1.0.0"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^E([1-9]|1[0-9]|2[0-2])$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "invalidated"
      ]
    },
    "configuration": {
      "type": "string"
    },
    "dataset_snapshot": {
      "type": "object",
      "required": [
        "name",
        "version_or_hash",
        "split"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version_or_hash": {
          "type": "string"
        },
        "split": {
          "type": "string"
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "label_snapshot_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "dirty_worktree": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "python",
        "hardware"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "hardware": {
          "type": "string"
        },
        "container_image_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "provider",
          "model_id",
          "version"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "prompt_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "metrics": {
      "type": "object"
    },
    "statistical_analysis": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
