{
  "experiment_id": "E8-CPU-StaticEmbedding-v2",
  "parent_experiment": "E8",
  "status": "implementation_candidate",
  "method": "fasttext_skipgram_idf_weighted_mean_cosine",
  "datasets": [
    "ToolRet heterogeneous retrieval track",
    "MCPToolBench++ strict single-primary-target track"
  ],
  "track_policy": "evaluate_separately_never_pool",
  "metrics": ["Hit@1", "Hit@5", "MRR@10", "macro_Hit@1"],
  "fasttext": {
    "package": "fasttext-wheel==0.9.2",
    "model": "skipgram",
    "dimension": 300,
    "window": 5,
    "minn": 3,
    "maxn": 6,
    "negative": 5,
    "epoch": 10,
    "minCount": 1,
    "thread": 1,
    "loss": "ns"
  },
  "pooling": "smoothed_idf_weighted_mean_l2_normalized",
  "idf": "ln((N+1)/(df(t)+1))+1; tool documents only",
  "similarity": "exact_cosine",
  "top_k": 10,
  "checkpoint_tasks": 16,
  "seed_note": "The E8 seed may govern deterministic task order/sampling only; FastText train_unsupervised has no documented user seed parameter.",
  "gpu": "disabled",
  "llm": "not_used",
  "cross_encoder": "not_used",
  "immutability": "new isolated variant; original E8 unchanged"
}
