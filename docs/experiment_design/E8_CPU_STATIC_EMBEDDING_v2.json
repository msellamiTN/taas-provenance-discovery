{
  "experiment_id": "E8-CPU-StaticEmbedding-v2",
  "parent_experiment": "E8",
  "status": "implementation_candidate",
  "method": "pretrained_fasttext_cc_en_300_idf_weighted_mean_cosine",
  "datasets": [
    "ToolRet heterogeneous retrieval track",
    "MCPToolBench++ strict single-primary-target track"
  ],
  "track_policy": "evaluate_separately_never_pool",
  "metrics": [
    "Hit@1",
    "Hit@5",
    "MRR@10",
    "macro_Hit@1"
  ],
  "model": {
    "family": "FastText",
    "artifact": "cc.en.300.bin",
    "source_url": "https://dl.fbaipublicfiles.com/fasttext/vectors-crawl/cc.en.300.bin.gz",
    "training_corpus": "Common Crawl + Wikipedia",
    "original_training_objective": "CBOW with position weights",
    "dimension": 300,
    "subword_character_ngrams": true,
    "supports_oov": true,
    "inference_only": true,
    "training_or_finetuning_in_e8": false,
    "license": "check official distribution terms before redistribution"
  },
  "storage": {
    "default_mode": "ephemeral",
    "stream_gzip_decompression": true,
    "minimum_free_disk_gib": 8,
    "persistent_cache_optional": true,
    "commit_model_to_git": false,
    "remove_temporary_binary_after_load": true
  },
  "pooling": "smoothed_idf_weighted_mean_l2_normalized",
  "idf": "ln((N+1)/(df(t)+1))+1; candidate tool documents only; per track",
  "similarity": "exact_cosine",
  "top_k": 10,
  "checkpoint_tasks": 16,
  "gpu": "disabled",
  "llm": "not_used",
  "cross_encoder": "not_used",
  "immutability": "new isolated variant; original E8 unchanged"
}
