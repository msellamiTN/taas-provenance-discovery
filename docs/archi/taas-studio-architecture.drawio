 height="64" as="geometry"/></mxCell><mxCell id="c18" value="Bidirectional JSON-RPC: notifications/elicitation/&lt;br&gt;sampling = covert channel; REST model unfit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="404" width="560" height="64" as="geometry"/></mxCell><mxCell id="c19" value="Session↔identity binding, notification allow-list,&lt;br&gt;elicitation interception (LAD D11, FR-INT-9)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="404" width="580" height="64" as="geometry"/></mxCell><mxCell id="c20" value="Approval TOCTOU" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="230" height="64" as="geometry"/></mxCell><mxCell id="c21" value="Approving call X must not authorize call Y" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="480" width="560" height="64" as="geometry"/></mxCell><mxCell id="c22" value="Approval = hash(policy_fp, tool, canonical_args,&lt;br&gt;evidence) — reuse with different args fails" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="480" width="580" height="64" as="geometry"/></mxCell><mxCell id="c23" value="Description injection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="230" height="64" as="geometry"/></mxCell><mxCell id="c24" value="Tool descriptions are untrusted input delivered&lt;br&gt;through a trusted channel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="556" width="560" height="64" as="geometry"/></mxCell><mxCell id="c25" value="Registry-side linting/sanitization at inspection&lt;br&gt;(FR-SEC-7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="556" width="580" height="64" as="geometry"/></mxCell><mxCell id="c26" value="Observation ≠ origin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="230" height="64" as="geometry"/></mxCell><mxCell id="c27" value="Snapshots prove what was observed, not what&lt;br&gt;served it — swapped backend still valid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="632" width="560" height="64" as="geometry"/></mxCell><mxCell id="c28" value="Artifact provenance: image digest + SBOM +&lt;br&gt;SLSA attestation (E9)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="632" width="580" height="64" as="geometry"/></mxCell><mxCell id="c29" value="Divergent enforcement" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="230" height="64" as="geometry"/></mxCell><mxCell id="c30" value="route_ref schema-identical but K8s GW API has&lt;br&gt;no WAF; PrivateLink unidirectional" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="708" width="560" height="64" as="geometry"/></mxCell><mxCell id="c31" value="Per-env capability matrix + conformance tests —&lt;br&gt;contract promises the floor (PAD §7.6)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="708" width="580" height="64" as="geometry"/></mxCell><mxCell id="c32" value="Broker SPOF" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="230" height="64" as="geometry"/></mxCell><mxCell id="c33" value="Token broker sits in the data path; JWKS/IdP&lt;br&gt;outage behavior undesigned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="784" width="560" height="64" as="geometry"/></mxCell><mxCell id="c34" value="HA replicas, JWKS cache TTL+rotation, IdP outage&lt;br&gt;fail-closed new-publish / cached serving (PAD §7.7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="784" width="580" height="64" as="geometry"/></mxCell><mxCell id="c35" value="None of these change the delivered Studio surface — they are Phase B/C seams recorded so the architecture cannot quietly assume guarantees it does not yet enforce." style="text;html=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="875" width="1200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
