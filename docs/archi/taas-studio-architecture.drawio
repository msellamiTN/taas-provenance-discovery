  <diagram name="STU-07-Threat-Gap-Map" id="st7"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="STU-07 · Threat &amp; assurance gap map — findings from principal-architect review → required seams" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="c2" value="Finding" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;fillColor=#fbeaea;strokeColor=#a05a5a;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="230" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Why it matters (module-level)" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="285" y="60" width="560" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Required seam (decision/requirement)" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;fillColor=#eaf6ea;strokeColor=#4d7a4d;rounded=1;" vertex="1" parent="1"><mxGeometry x="860" y="60" width="580" height="30" as="geometry"/></mxCell><mxCell id="c5" value="Audit self-attestation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="64" as="geometry"/></mxCell><mxCell id="c6" value="audit_ledger.py hash-chains into a file the Studio&lt;br&gt;controls — producer is sole anchor" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="100" width="560" height="64" as="geometry"/></mxCell><mxCell id="c7" value="External anchor: signed digests → WORM/witness log;&lt;br&gt;SIEM streaming export (LAD D12, NFR-AUD-3)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="580" height="64" as="geometry"/></mxCell><mxCell id="c8" value="Enforcement inside gated domain" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="230" height="64" as="geometry"/></mxCell><mxCell id="c9" value="PEP/policy/ledger share the Studio's admin &amp;&lt;br&gt;failure domain — gate can disable its own gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="176" width="560" height="64" as="geometry"/></mxCell><mxCell id="c10" value="Separate identity/admin domains mandatory in&lt;br&gt;any gating phase (LAD D14, NFR-SEC-5)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="176" width="580" height="64" as="geometry"/></mxCell><mxCell id="c11" value="Bearer replay" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="230" height="64" as="geometry"/></mxCell><mxCell id="c12" value="OAuth bearer tokens are replayable; tool path is&lt;br&gt;the highest-value credential" style="rounded=1;whiteSpace=wrap;html=1;fontS