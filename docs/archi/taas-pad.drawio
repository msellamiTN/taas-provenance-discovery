560" y="440" width="380" height="40" as="geometry"/></mxCell><mxCell id="d8" value="NET-08 → private DNS (fwd/peering)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="380" height="40" as="geometry"/></mxCell><mxCell id="d9" value="NET-09 → registry+gw mgmt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="380" height="40" as="geometry"/></mxCell><mxCell id="d10" value="NET-10 → observability/SIEM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="380" height="40" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s1" target="d1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s2" target="d7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s3" target="d8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s4" target="d9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="s3" target="d10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="PAD-05-Private-Conn-Checklist" id="pd5"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="PAD-05 · Private-connectivity record — required per PSC / PrivateLink / Private Link" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="pr" value="Producer side&lt;br&gt;────────&lt;br&gt;project/VPC/region&lt;br&gt;service attachment ID&lt;br&gt;accepted/rejected state&lt;br&gt;connection preference" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="270" height="150" as="geometry"/></mxCell><mxCell id="cn" value="Consumer side&lt;br&gt;────────&lt;br&gt;project/VPC/region&lt;br&gt;endpoint ID + IP/subnet&lt;br&gt;DNS record + zone owner" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="270" height="150" as="geometry"/></mxCell><mxCell id="fl" value="Flow attributes&lt;br&gt;────────&lt;br&gt;firewall + routes both sides&lt;br&gt;health-check + failover&lt;br&gt;maintenance owner&lt;br&gt;role: ingress-gw / gw-rt / gw-model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="70" width="320" height="150" as="geometry"/></mxCell><mxCell id="c5" value="attachment ≠ endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="pr" target="cn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="cn" target="fl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rl" value="Port &amp; egress rules&lt;br&gt;────────&lt;br&gt;· private FQDNs only, never raw IPs&lt;br&gt;· explicit FQDN/IP/port allowlists, no wildcards&lt;br&gt;· TLS everywhere; verify each listener, never assume 443&lt;br&gt;· MCP proxy reachable only via gateway path (NetworkPolicy)&lt;br&gt;· prefer private connectivity for internal/model endpoints&lt;br&gt;· public SaaS only via approved egress path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="520" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="PAD-06-DNS-Environments" id="pd6"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="PAD-06 · DNS design + environment strategy" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="dn" value="DNS design&lt;br&gt;────────&lt;br&gt;· private FQDNs for all backends&lt;br&gt;· zone ownership + change process&lt;br&gt;· split-horizon where required&lt;br&gt;· peering/forwarding direction recorded&lt;br&gt;· records: FQDN/type/target/TTL&lt;br&gt;· SAN covers exact published FQDNs&lt;br&gt;· env names never cross-resolve&lt;br&gt;· example (TBD): mcp-gw.example.corp" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="360" height="220" as="geometry"/></mxCell><mxCell id="e1" value="DEV&lt;br&gt;separate env + non-prod endpoints&lt;br&gt;test creds · synthetic data" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="320" height="90" as="geometry"/></mxCell><mxCell id="e2" value="TEST / INT&lt;br&gt;separate policies + test backends&lt;br&gt;representative data · SaaS sandboxes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="320" height="90" as="geometry"/></mxCell><mxCell id="e3" value="PREPROD&lt;br&gt;prod-like connectivity/policy&lt;br&gt;no uncontrolled prod data · release gate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="320" height="90" as="geometry"/></mxCell><mxCell id="e4" value="PROD&lt;br&gt;approved cluster/network + private DNS&lt;br&gt;prod IAM/secrets · audit retention · change windows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="850" y="190" width="320" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Environment differences are configuration overlays — never divergent manually-maintained bundles." style="text;html=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="PAD-07-Trust-DR" id="pd7"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="PAD-07 · Trust boundaries + availability/DR checklist" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="tb" value="Trust boundaries&lt;br&gt;────────&lt;br&gt;consumer→gw: TLS+token+scope, WAF&lt;br&gt;gw→proxy: pods-only NetworkPolicy&lt;br&gt;gw→backends: private endpoints+allowlist&lt;br&gt;gw→models: private conn + backend authN&lt;br&gt;gw→on-prem: SD-WAN+FW+mTLS+audit&lt;br&gt;gw→SaaS: egress allowlist+tenant limits&lt;br&gt;broker→IdP: trusted metadata+JWKS&lt;br&gt;orchestrator→planes: workload ID+least priv&lt;br&gt;admin→planes: MFA/SSO+PAM+change audit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="420" height="240" as="geometry"/></mxCell><mxCell id="dr" value="Availability / DR checklist&lt;br&gt;────────&lt;br&gt;· ≥2 runtime clusters where traffic diversion needed&lt;br&gt;· health checks: gw, registry, runtimes, backends&lt;br&gt;· registry outage → cached-policy serving only;&lt;br&gt;  new publications FAIL CLOSED&lt;br&gt;· backend fail → documented timeout/retry/breaker&lt;br&gt;· never silently switch model providers&lt;br&gt;· backups: registry + gw config + stateful parts&lt;br&gt;· rollback: publication, policy, schema, upgrade&lt;br&gt;· RTO/RPO/availability/retention = TBD per env" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="460" height="240" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="PAD-08-Deploy-TestPlan" id="pd8"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="PAD-08 · Deployment pipeline + physical test plan PT-01..14" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p1" value="Source&lt;br&gt;bundles·routes·schemas·overlays" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="180" height="70" as="geometry"/></mxCell><mxCell id="p2" value="CI/CD&lt;br&gt;static checks·secret scan·policy tests·approvals" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="p3" value="Deploy&lt;br&gt;least-priv identity · audited release" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="p4" value="Reconcile&lt;br&gt;drift detect + correct (scheduled)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="p1" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="p2" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="p3" target="p4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t1" value="PT-01..07 — connectivity &amp; identity&lt;br&gt;────────&lt;br&gt;01 FQDN resolve per env&lt;br&gt;02 endpoint/attachment state&lt;br&gt;03 TLS chain + SAN&lt;br&gt;04 unauthorized pod→proxy denied&lt;br&gt;05 consumer→MCP direct denied+logged&lt;br&gt;06 private path to MCP service&lt;br&gt;07 model backend via approved route" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="360" height="220" as="geometry"/></mxCell><mxCell id="t2" value="PT-08..14 — behavior &amp; hygiene&lt;br&gt;────────&lt;br&gt;08 on-prem API approved route&lt;br&gt;09 SaaS egress: allowed pass / non-listed denied&lt;br&gt;10 invalid/expired/wrong-aud token → 401&lt;br&gt;11 consumer token replayed downstream → rejected&lt;br&gt;12 registry outage → cached-policy only; publish fails closed&lt;br&gt;13 orphan proxy/registry state detected after failed publish&lt;br&gt;14 egress + log redaction review clean" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="460" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
