        <mxCell id="pd5p" value="Producer side&lt;br&gt;———&lt;br&gt;project/VPC/region&lt;br&gt;service attachment ID&lt;br&gt;accepted/rejected state&lt;br&gt;connection preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="pd5c" value="Consumer side&lt;br&gt;———&lt;br&gt;project/VPC/region&lt;br&gt;endpoint ID + IP/subnet&lt;br&gt;DNS record + zone owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="pd5f" value="Flow attributes&lt;br&gt;———&lt;br&gt;firewall + routes both sides&lt;br&gt;health-check + failover&lt;br&gt;maintenance owner&lt;br&gt;role: ingress-gw / gw-rt / gw-model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="pd5e1" value="attachment ≠ endpoint&lt;br&gt;identify producer vs consumer per flow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="pd5p" target="pd5c" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd5e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="pd5c" target="pd5f" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd5rules" value="Rules&lt;br&gt;———&lt;br&gt;· private FQDNs only, never raw IPs&lt;br&gt;· explicit FQDN/IP/port allowlists, no wildcards&lt;br&gt;· TLS everywhere; verify each listener, never assume 443&lt;br&gt;· MCP proxy reachable only via gateway path (NetworkPolicy)&lt;br&gt;· prefer private connectivity for internal/model endpoints&lt;br&gt;· public SaaS only via approved egress path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="480" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="PAD-06-DNS-Environments" id="pd6">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pd6t" value="PAD §6 + §11 — DNS design and environment strategy" style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="pd6dns" value="DNS design&lt;br&gt;———&lt;br&gt;· private FQDNs for all backends&lt;br&gt;· zone ownership + change process&lt;br&gt;· split-horizon where required&lt;br&gt;· peering/forwarding direction recorded&lt;br&gt;· records: FQDN/type/target/TTL&lt;br&gt;· SAN covers exact published FQDNs&lt;br&gt;· env names never cross-resolve&lt;br&gt;· example (TBD): mcp-gw.example.corp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="pd6e1" value="DEV&lt;br&gt;separate env + non-prod endpoints&lt;br&gt;test creds · synthetic data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="pd6e2" value="TEST / INT&lt;br&gt;separate policies + test backends&lt;br&gt;representative data · SaaS sandboxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="pd6e3" value="PREPROD&lt;br&gt;prod-like connectivity/policy&lt;br&gt;no uncontrolled prod data · release gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="pd6e4" value="PROD&lt;br&gt;approved cluster/network + private DNS&lt;br&gt;prod IAM/secrets · audit retention · change windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="pd6nt" value="Environment differences are configuration overlays — never divergent manually-maintained bundles." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="800" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="PAD-07-Trust-DR" id="pd7">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pd7t" value="PAD §8 + §9 — Trust boundaries and availability/DR checklist" style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="800" height="24" as="geometry"/></mxCell>
        <mxCell id="pd7tb" value="Trust boundaries&lt;br&gt;———&lt;br&gt;consumer→gw: TLS+token+scope, WAF&lt;br&gt;gw→proxy: pods-only NetworkPolicy&lt;br&gt;gw→backends: private endpoints+allowlist&lt;br&gt;gw→models: private conn + backend authN&lt;br&gt;gw→on-prem: SD-WAN+FW+mTLS+audit&lt;br&gt;gw→SaaS: egress allowlist+tenant limits&lt;br&gt;broker→IdP: trusted metadata+JWKS&lt;br&gt;orchestrator→planes: workload ID+least priv&lt;br&gt;admin→planes: MFA/SSO+PAM+change audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="pd7dr" value="Availability / DR checklist&lt;br&gt;———&lt;br&gt;· ≥2 runtime clusters where traffic diversion needed&lt;br&gt;· health checks: gw, registry, runtimes, backends&lt;br&gt;· registry outage → cached-policy serving only;&lt;br&gt;  new publications FAIL CLOSED&lt;br&gt;· backend fail → documented timeout/retry/breaker&lt;br&gt;· never silently switch model providers&lt;br&gt;· backups: registry + gw config + stateful parts&lt;br&gt;· rollback: publication, policy, schema, upgrade&lt;br&gt;· RTO/RPO/availability/retention = TBD per env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="420" height="230" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="PAD-08-Deploy-TestPlan" id="pd8">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pd8t" value="PAD §12–§14 — Deployment pipeline and physical test plan PT-01..14" style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="800" height="24" as="geometry"/></mxCell>
        <mxCell id="pd8p1" value="Source&lt;br&gt;bundles · routes ·&lt;br&gt;schemas · overlays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="pd8p2" value="CI/CD&lt;br&gt;static checks · secret scan&lt;br&gt;policy tests · approvals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="pd8p3" value="Deploy&lt;br&gt;least-priv identity&lt;br&gt;audited release job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="pd8p4" value="Reconcile&lt;br&gt;drift detect + correct&lt;br&gt;(scheduled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="pd8e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="pd8p1" target="pd8p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd8e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="pd8p2" target="pd8p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd8e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="pd8p3" target="pd8p4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pd8t1" value="PT-01..07 connectivity &amp; identity&lt;br&gt;———&lt;br&gt;01 FQDN resolve per env&lt;br&gt;02 endpoint/attachment state&lt;br&gt;03 TLS chain + SAN&lt;br&gt;04 unauthorized pod→proxy denied&lt;br&gt;05 consumer→MCP direct denied+logged&lt;br&gt;06 private path to MCP service&lt;br&gt;07 model backend via approved route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="pd8t2" value="PT-08..14 behavior &amp; hygiene&lt;br&gt;———&lt;br&gt;08 on-prem API approved route&lt;br&gt;09 SaaS egress: allowed pass / non-listed denied&lt;br&gt;10 invalid/expired/wrong-aud token → 401&lt;br&gt;11 consumer token replayed downstream → rejected&lt;br&gt;12 registry outage → cached-policy only; publish fails closed&lt;br&gt;13 orphan proxy/registry state detected after failed publish&lt;br&gt;14 egress + log redaction review clean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="450" y="200" width="430" height="210" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
