"c" value="AWS&lt;br&gt;────────&lt;br&gt;API GW / ALB / NLB&lt;br&gt;PrivateLink endpoint services&lt;br&gt;IAM / Identity Center&lt;br&gt;Secrets Manager&lt;br&gt;Bedrock (private)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="290" height="160" as="geometry" /></mxCell><mxCell id="d" value="Azure&lt;br&gt;────────&lt;br&gt;APIM / App Gateway&lt;br&gt;Private Link / private endpoints&lt;br&gt;Entra ID (native broker)&lt;br&gt;Key Vault · workload identity&lt;br&gt;Azure AI / Foundry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="290" height="160" as="geometry" /></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="lc" target="a" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="lc" target="b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="lc" target="c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="lc" target="d" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" value="AC-05: identical logical contract across all four environments. Status: design — not implemented." style="text;html=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1200" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram>
