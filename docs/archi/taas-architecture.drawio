        <mxCell id="p7pr" value="Private / on-prem&lt;br&gt;———&lt;br&gt;&lt;b&gt;Kubernetes Gateway API&lt;/b&gt;&lt;br&gt;GatewayClass (Envoy GW / NGINX / Kong)&lt;br&gt;Gateway + HTTPRoute&lt;br&gt;NetworkPolicy: proxy pods only&lt;br&gt;Vault · Keycloak · K3s/kubeadm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="280" height="160" as="geometry" /></mxCell>
        <mxCell id="p7gc" value="GCP&lt;br&gt;———&lt;br&gt;ApigeeX / Apigee Hybrid&lt;br&gt;PSC inbound/outbound endpoints&lt;br&gt;service attachments + internal LB&lt;br&gt;Secret Manager · Workload Identity&lt;br&gt;Vertex AI / Model Garden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="280" height="160" as="geometry" /></mxCell>
        <mxCell id="p7aw" value="AWS&lt;br&gt;———&lt;br&gt;API Gateway / ALB / NLB&lt;br&gt;PrivateLink endpoint services&lt;br&gt;IAM / Identity Center federation&lt;br&gt;Secrets Manager&lt;br&gt;Bedrock via private connectivity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="250" width="280" height="160" as="geometry" /></mxCell>
        <mxCell id="p7az" value="Azure&lt;br&gt;———&lt;br&gt;API Management / App Gateway&lt;br&gt;Private Link / private endpoints&lt;br&gt;Microsoft Entra ID (native broker)&lt;br&gt;Key Vault · workload identity&lt;br&gt;Azure AI / Foundry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="280" height="160" as="geometry" /></mxCell>
        <mxCell id="p7e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p7l" target="p7pr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p7l" target="p7gc" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p7l" target="p7aw" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p7l" target="p7az" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p7nt" value="AC-04: private cloud must pass with Gateway API resources only — no cloud-specific CRDs.&lt;br&gt;AC-05: identical logical contract across all four." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="700" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="ENT · 08-Identity-Trust" id="p8">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8t" value="Five identity domains — never conflated (LAD §9.1)" style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="600" height="24" as="geometry" /></mxCell>
        <mxCell id="p8i1" value="1 · Consumer principal&lt;br&gt;app/agent caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="p8i2" value="2 · End-user principal&lt;br&gt;delegated context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="p8i3" value="3 · Gateway workload identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p8i4" value="4 · Agent runtime identity&lt;br&gt;spec.identity.workload_identity_ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="p8i5" value="5 · Backend / MCP identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p8e1" value="exchange / delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="p8i1" target="p8i3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8e2" value="on-behalf-of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="p8i2" target="p8i3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p8i3" target="p8i4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8e4" value="own authZ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="p8i4" target="p8i5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8tb" value="Trust boundaries&lt;br&gt;———&lt;br&gt;consumer→gateway: TLS + token + scope&lt;br&gt;gateway→proxy: pods-only network policy&lt;br&gt;gateway→backend: private endpoints + allowlist&lt;br&gt;gateway→on-prem: SD-WAN + firewall + mTLS&lt;br&gt;gateway→SaaS: controlled egress + tenant limits&lt;br&gt;orchestrator→planes: workload identity + least privilege" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="380" height="200" as="geometry" /></mxCell>
        <mxCell id="p8th" value="Threats → controls&lt;br&gt;———&lt;br&gt;confused deputy → no token passthrough (D5)&lt;br&gt;over-exposed tools → filtered tools/list&lt;br&gt;SSRF → FQDN allowlists, no raw IP&lt;br&gt;injection→unsafe call → tools/call PEP-gated&lt;br&gt;fine-grained rules → AuthZEN facade → ReBAC/ABAC&lt;br&gt;insufficient scope → 403 + step-up (RFC 6750)&lt;br&gt;secret leakage → no payload logging · opaque tokens&lt;br&gt;replay/DoS → quota + size caps&lt;br&gt;cross-tenant → RBAC + isolation (Phase B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="420" height="200" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="ENT · 09-Observability-Audit" id="p9">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9a" value="API Gateway / MCP proxy&lt;br&gt;decision logs · latency · deny events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="p9b" value="Control plane (Studio API)&lt;br&gt;structured JSON request log&lt;br&gt;{event, request_id, path, status, ms}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="p9c" value="Audit chain&lt;br&gt;exposure.* · gateway.decision · token.exchange&lt;br&gt;payload.request_id ↔ seq correlation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="p9d" value="Observability platform&lt;br&gt;metrics · traces · dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="p9e" value="SIEM export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="p9e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p9a" target="p9c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p9e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p9b" target="p9c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p9e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p9c" target="p9d" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p9e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p9d" target="p9e" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p9nt" value="Never logged: tokens · API keys · passwords · unredacted payloads.&lt;br&gt;Dashboards: tools/list vs tools/call volume · denied calls · drift · per-provider backend latency/errors · endpoint health.&lt;br&gt;Tamper evidence only — the chain proves records were not altered, never that claims were true." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="900" height="80" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="ENT · 10-Boundary-Execution" id="p10">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p10t" value="Boundary invariant: proposal ≠ evidence ≠ authorization ≠ execution" style="text;html=1;fontSize=14;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry" /></mxCell>
        <mxCell id="p10a" value="Proposal&lt;br&gt;GoalSpec / manifest drafts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="p10b" value="Evidence&lt;br&gt;certificates · witnesses · audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p10c" value="Authorization&lt;br&gt;policy + approvals (Phase B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p10d" value="Execution&lt;br&gt;PEP + isolated workers (Phase C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p10x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="p10a" target="p10b" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p10y" value="≠" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;" edge="1" source="p10b" target="p10c" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p10z" value="≠" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=14;" edge="1" source="p10c" target="p10d" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p10pep" value="Phase C governed path&lt;br&gt;———&lt;br&gt;gateway → policy check → PEP → isolated worker&lt;br&gt;→ fresh evidence check → one-time approval → tools/call&lt;br&gt;&lt;br&gt;Current Studio: inspection only · tools/list read ·&lt;br&gt;inspection_only=true · tool_execution_performed=false&lt;br&gt;· no /tools/call route exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="460" height="160" as="geometry" /></mxCell>
        <mxCell id="p10nt" value="A published manifest is not a runtime guarantee. A valid certificate is not proof of runtime behavior.&lt;br&gt;Hash-chain verification = tamper evidence only. UNAVAILABLE is always preferred over fabricated state." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="800" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>