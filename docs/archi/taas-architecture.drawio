 injection" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="230" height="64" as="geometry" /></mxCell><mxCell id="c24" value="Tool descriptions are untrusted input delivered&lt;br&gt;through a trusted channel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="556" width="560" height="64" as="geometry" /></mxCell><mxCell id="c25" value="Registry-side linting/sanitization at inspection&lt;br&gt;(FR-SEC-7)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="860" y="556" width="580" height="64" as="geometry" /></mxCell><mxCell id="c26" value="Observation ≠ origin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="230" height="64" as="geometry" /></mxCell><mxCell id="c27" value="Snapshots prove what was observed, not what&lt;br&gt;served it — swapped backend still valid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="285" y="632" width="560" height="64" as="geometry" /></mxCell><mxCell id="c28" value="Artifact provenance: image digest + SBOM +&lt;br&gt;SLSA attestation (E9)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;dashed=