  <diagram name="LAD-06-Identity-Threats" id="l6">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l6t" value="LAD §9 — Five identity domains + control layers + threat→control map" style="text;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="24" as="geometry"/></mxCell>
        <mxCell id="l6i1" value="1 · Consumer principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="l6i2" value="2 · End-user principal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="l6i3" value="3 · Gateway workload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="l6i4" value="4 · Agent runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="l6i5" value="5 · Backend / MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="l6e1" value="exchange/delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="l6i1" target="l6i3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l6e2" value="on-behalf-of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="l6i2" target="l6i3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l6e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="l6i3" target="l6i4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l6e4" value="own authZ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="l6i4" target="l6i5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l6cl" value="Control layers&lt;br&gt;Edge TLS/WAF/size → Identity (validate+exchange)&lt;br&gt;→ Policy (exposure/quota) → Routing (allowlist)&lt;br&gt;→ Audit (correlated) → Observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="440" height="110" as="geometry"/></mxCell>
        <mxCell id="l6th" value="Threat → control&lt;br&gt;———&lt;br&gt;confused deputy → no passthrough (D5)&lt;br&gt;audience/scope misuse → iss/aud/sig/exp checks&lt;br&gt;over-exposed tools → filtered tools/list&lt;br&gt;SSRF → FQDN allowlists, no raw IP&lt;br&gt;injection→unsafe call → tools/call PEP-gated&lt;br&gt;insufficient scope → 403 + step-up (6750)&lt;br&gt;fine-grained rules → AuthZEN→ReBAC/ABAC&lt;br&gt;secret leakage → no payload logs · opaque tokens&lt;br&gt;replay/DoS → quotas + 2 MiB cap&lt;br&gt;cross-tenant → RBAC + isolation (Phase B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="560" y="250" width="480" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
