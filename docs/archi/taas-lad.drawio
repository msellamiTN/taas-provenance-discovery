" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="a2" target="a3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="Phase C — governed invocation (design only)" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;fillColor=#fbeaea;strokeColor=#a05a5a;rounded=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1160" height="200" as="geometry"/></mxCell><mxCell id="b1" value="Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=3 3;" vertex="1" parent="c8"><mxGeometry x="120" y="70" width="140" height="60" as="geometry"/></mxCell><mxCell id="b2" value="Policy check&lt;br&gt;+ AuthZEN FGA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=3 3;" vertex="1" parent="c8"><mxGeometry x="320" y="70" width="170" height="60" as="geometry"/></mxCell><mxCell id="b3" value="PEP + isolated worker&lt;br&gt;fresh evidence&lt;br&gt;one-time approval" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=3 3;" vertex="1" parent="c8"><mxGeometry x="550" y="60" width="210" height="90" as="geometry"/></mxCell><mxCell id="b4" value="tools/call&lt;br&gt;(audited)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;dashPattern=3 3;" vertex="1" parent="c8"><mxGeometry x="830" y="70" width="160" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="b1" target="b2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id