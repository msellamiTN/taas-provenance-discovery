  <diagram name="LAD-06-Identity-Threats" id="l6"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LAD-06 · Five identity domains + control layers + threat map" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="i1" value="1 Consumer&lt;br&gt;principal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="160" height="55" as="geometry"/></mxCell><mxCell id="i2" value="2 End-user&lt;br&gt;principal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="155" width="160" height="55" as="geometry"/></mxCell><mxCell id="i3" value="3 Gateway&lt;br&gt;workload identity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="170" height="55" as="geometry"/></mxCell><mxCell id="i4" value="4 Agent runtime&lt;br&gt;identity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="170" height="55" as="geometry"/></mxCell><mxCell id="i5" value="5 Backend / MCP&lt;br&gt;identity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="170" height="55" as="geometry"/></mxCell><mxCell id="c7" value="exchange/delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="i1" target="i3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="on-behalf-of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="i2" target="i3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="i3" target="i4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="own authZ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="i4" target="i5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cl" value="Control layers&lt;br&gt;Edge TLS/WAF/size → Identity (validate+exchange)&lt;br&gt;→ Policy (exposure/quota) → Routing (allowlist)&lt;br&gt;→ Audit (correlated) → Observability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="450" height="120" as="geometry"/></mxCell><mxCell id="th" value="Threat → control&lt;br&gt;────────&lt;br&gt;confused deputy → no passthrough (D5)&lt;br&gt;audience misuse → iss/aud/sig/exp checks&lt;br&gt;over-exposed tools → filtered tools/list&lt;br&gt;SSRF → FQDN allowlists, no raw IP&lt;br&gt;injection→unsafe call → tools/call PEP-gated&lt;br&gt;insufficient scope → 403 + step-up (6750)&lt;br&gt;fine-grained rules → AuthZEN→ReBAC/ABAC&lt;br&gt;secret leakage → no payload logs · opaque tokens&lt;br&gt;replay/DoS → quotas + 2 MiB cap&lt;br&gt;cross-tenant → RBAC + isolation (Phase B)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="500" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="LAD-07-Decisions" id="l7"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LAD-07 · Decision map — D1..D14 around the centralized gateway" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="core" value="Centralized&lt;br&gt;MCP gateway&lt;br&gt;(D1)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="160" height="110" as="geometry"/></mxCell><mxCell id="d2" value="D2 Token broker&lt;br&gt;IdP-agnostic" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="d9" value="D9 AuthZEN→ReBAC/ABAC" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="d6" value="D6 REST→MCP adapter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="d8" value="D8 Orchestrated prov.&lt;br&gt;+ drift" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="950" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="d11" value="D11 MCP session &amp;&lt;br&gt;notificat