  <diagram name="LAD-05-Registry-Model" id="l5"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="LAD-05 · Registry data model — italic = design-seam extension fields (E1–E3)" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="ag" value="Agent (v1alpha1)&lt;br&gt;────────&lt;br&gt;model · instructions&lt;br&gt;tool_allowlist · resources&lt;br&gt;approval · lifecycle_state&lt;br&gt;+ identity.workload_identity_ref&lt;br&gt;+ exposure { publish_via, scopes }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="300" height="180" as="geometry"/></mxCell><mxCell id="mc" value="MCP server&lt;br&gt;────────&lt;br&gt;id · transport · inspection history&lt;br&gt;health · lifecycle_state&lt;br&gt;+ exposure { mode, route_ref,&lt;br&gt; private_endpoint, dns_name,&lt;br&gt; adapter, backends[] }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="300" height="180" as="geometry"/></mxCell><mxCell id="pp" value="Policy profile&lt;br&gt;────────&lt;br&gt;selection policy (UX-17)&lt;br&gt;+ exposure_rules { consumer_scopes,&lt;br&gt; tools_visible, tools_callable*,&lt;br&gt; egress_class, quota }" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="310" height="160" as="geometry"/></mxCell><mxCell id="ep" value="Endpoint&lt;br&gt;────────&lt;br&gt;private FQDN / route_ref&lt;br&gt;service attachment / LB ref&lt;br&gt;(never a raw-IP runtime claim)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="310" height="120" as="geometry"/></mxCell><mxCell id="ev" value="Evidence / audit&lt;br&gt;────────&lt;br&gt;hash-chained events · signed bundles&lt;br&gt;request_id ↔ seq&lt;br&gt;+ kinds: exposure.* · gateway.decision&lt;br&gt; · token.exchange" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="310" height="160" as="geometry"/></mxCell><mxCell id="lc" value="Lifecycle&lt;br&gt;REGISTERED→VALIDATED→READY&lt;br&gt;→PUBLISHED→REVOKED&lt;br&gt;(config states, never runtime)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;align=left;spacingLeft=8;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="300" width="310" height="120" as="geometry"/></mxCell><mxCell id="c8" value="tool grants" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="ag" target="mc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="policy_profile_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" source="ag" target="pp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;