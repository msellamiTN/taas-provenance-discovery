        <mxCell id="l5e2" value="policy_profile_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="l5ag" target="l5pp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
