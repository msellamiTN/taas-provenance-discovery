        <mxCell id="l5ag" value="Agent&lt;br&gt;———&lt;br&gt;id · version · owner&lt;br&gt;model · instructions&lt;br&gt;tool_allowlist · resources&lt;br&gt;approval · lifecycle_state&lt;br&gt;&lt;i&gt;+ identity.workload_identity_ref&lt;br&gt;+ exposure { publish_via, scopes }&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="l5mc" value="MCP server&lt;br&gt;———&lt;br&gt;id · transport · endpoints&lt;br&gt;inspection history · health&lt;br&gt;lifecycle_state&lt;br&gt;&lt;i&gt;+ exposure { mode, route_ref,&lt;br&gt;private_endpoint, dns_name,&lt;br&gt;adapter, backends[] }&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="l5pp" value="Policy profile&lt;br&gt;———&lt;br&gt;id · selection policy&lt;br&gt;&lt;i&gt;+ exposure_rules { consumer_scopes,&lt;br&gt;tools_visible, tools_callable*,&lt;br&gt;egress_class, quota }&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="l5ep" value="Endpoint&lt;br&gt;———&lt;br&gt;private FQDN / route_ref&lt;br&gt;service attachment / LB ref&lt;br&gt;&lt;i&gt;never a raw-IP runtime claim&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1"><mxGeometry x="440" y="310" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="l5ev" value="Evidence / audit&lt;br&gt;———&lt;br&gt;hash-chained events&lt;br&gt;signed bundles&lt;br&gt;request_id ↔ seq&lt;br&gt;&lt;i&gt;+ kinds: exposure.* ·&lt;br&gt;gateway.decision · token.exchange&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;" vertex="1" parent="1"><mxGeometry x="790" y="80" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="l5lc" value="Lifecycle&lt;br&gt;REGISTERED → VALIDATED →&lt;br&gt;READY → PUBLISHED →&lt;br&gt;REVOKED / DECOMMISSIONED&lt;br&gt;&lt;i&gt;config states, never runtime&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1"><mxGeometry x="790" y="310" width="270" height="120" as="geometry"/></mxCell>
