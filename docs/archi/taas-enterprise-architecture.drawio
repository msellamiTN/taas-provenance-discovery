<mxfile host="app.diagrams.net" agent="taas" version="24.0.0">
  <diagram name="01-Platform-Context" id="p1"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="TaaS target platform — consumers reach tools only through the governed edge; the control plane governs, it is never in the request path" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1200" height="26" as="geometry"/></mxCell><mxCell id="c2" value="T0 — Untrusted consumers" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="170" height="700" as="geometry"/></mxCell><mxCell id="k1" value="Business apps&lt;br&gt;/ frontends" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c2"><mxGeometry x="20" y="50" width="130" height="55" as="geometry"/></mxCell><mxCell id="k2" value="Agents&lt;br&gt;(LLM hosts)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c2"><mxGeometry x="20" y="140" width="130" height="55" as="geometry"/></mxCell><mxCell id="k3" value="M2M service&lt;br&gt;clients" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=8;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c2"><mxGeometry x="20" y="230" width="130" height="55" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;fontSize=10;image=https://icons.diagrams.net/assets/azure/1/Users.svg" vertex="1" parent="c2"><mxGeometry x="55" y="340"